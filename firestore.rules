rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Cualquier usuario autenticado lee la agenda, solo edita su propio perfil
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Solo los participantes de un chat pueden leerlo o escribir en él
    match /chats/{chatId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.participantes;
      
      // Permite la creación si el UID del usuario está en la solicitud
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantes;

      // Acceso a mensajes según pertenencia al chat padre
      match /mensajes/{mensajeId} {
        allow read, create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
      }
    }
  }
}
